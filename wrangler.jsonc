{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-developer-cloud-pool",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    "directory": "./web/jarvis-dashboard",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
